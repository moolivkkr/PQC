## AWS lambda nodejs22 openssl.cnf:
nodejs_conf = openssl_init
[openssl_init]
ssl_conf = ssl_sect
[ssl_sect]
system_default = system_default_sect
[system_default_sect]
Groups = X25519:secp256r1:X448:secp521r1:secp384r1:ffdhe2048:ffdhe3072:ffdhe4096:ffdhe6144:ffdhe8192
/var/runtime/bootstrap:14:# compatibility issues. Customers can opt-in to PQC by setting OPENSSL_CONF=/dev/null.
/var/runtime/bootstrap:15:if [ -z "${OPENSSL_CONF+set}" ]; then
/var/runtime/bootstrap:16:  export OPENSSL_CONF=/var/runtime/openssl_conf/openssl.cnf
